{
    "name": "lisachenko/scalar-objects",
    "description": "Method calls on PHP scalars with user-registerable handler classes, powered by a z-engine AST rewrite",
    "type": "library",
    "keywords": ["ffi", "scalar-objects", "ast", "z-engine", "method-call"],
    "license": "MIT",
    "authors": [
        {
            "name": "Alexander Lisachenko",
            "email": "lisachenko.it@gmail.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "ext-ffi": "*",
        "lisachenko/z-engine": "~8.4.2 || ~8.5.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.75",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "Lisachenko\\ScalarObjects\\": "src/"
        },
        "files": ["src/functions.php", "bootstrap.php"]
    },
    "scripts": {
        "test": "phpunit",
        "phpstan": "phpstan analyse",
        "cs:check": "php-cs-fixer fix --dry-run --diff",
        "cs:fix": "php-cs-fixer fix"
    },
    "scripts-descriptions": {
        "test": "Run the test suite",
        "phpstan": "Run static analysis at the maximum level",
        "cs:check": "Check coding standards without fixing",
        "cs:fix": "Fix coding standards"
    },
    "config": {
        "sort-packages": true
    },
    "repositories": {
    }
}
