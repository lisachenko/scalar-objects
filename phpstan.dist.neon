parameters:
    level: max
    phpVersion: 80400
    paths:
        - src
        - bootstrap.php
    # Generated engine struct stubs (ZEngine\Generated\*) - analysis-only views of the
    # C structs the rewriter reads through FFI\CData
    scanFiles:
        - vendor/lisachenko/z-engine/stubs/zend-engine-structs.php
    treatPhpDocTypesAsCertain: false
